{
  "title": "ArtifactQualityScore",
  "type": "object",
  "required": [
    "score",
    "threshold",
    "mode",
    "dimensions",
    "issues",
    "rework_tasks"
  ],
  "properties": {
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "threshold": {
      "type": "string",
      "enum": [
        "ready",
        "usable",
        "draft",
        "fail"
      ]
    },
    "score_threshold": {
      "type": "string",
      "enum": ["ready", "usable", "draft", "fail"]
    },
    "review": {
      "type": "object",
      "required": ["local_evidence", "independent_verification", "acceptance"],
      "properties": {
        "local_evidence": {
          "type": "object",
          "required": ["present", "missing", "unchecked"],
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "independent_verification": {"const": "not_performed"},
        "acceptance": {"const": "pending"}
      }
    },
    "mode": {
      "type": "string"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "points",
          "max_points",
          "evidence"
        ],
        "properties": {
          "points": {
            "type": "integer"
          },
          "max_points": {
            "type": "integer"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rework_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
